# Copy to .env.local and fill in. Never commit secrets.

# Google Calendar → Settings → the listing calendar → Integrate calendar
# → "Secret address in iCal format"
CALENDAR_ICS_URL="https://calendar.google.com/calendar/ical/your-secret-ical/private-xxx/basic.ics"

# Resend — email the host about a potential reservation
# API key: https://resend.com/api-keys
# Verify your domain, then set FROM to e.g. Dream Stay Budva <upiti@yourdomain.com>
# Until then, onboarding@resend.dev only delivers to your Resend account email.
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM="Dream Stay Budva <onboarding@resend.dev>"
HOST_EMAIL="host@example.com"

# WhatsApp Cloud API — notify the host after a successful inquiry email.
# Token: Meta Business Settings → System users → Generate token
# Phone number ID: App Dashboard → WhatsApp → API Setup → From
# HOST_WHATSAPP is the recipient (digits only), not the number shown on the site.
WHATSAPP_TOKEN="EAAxxxxxxxx"
WHATSAPP_PHONE_NUMBER_ID="000000000000000"
WHATSAPP_TEMPLATE_NAME="svoj_smestaj_host_inquiry"
WHATSAPP_TEMPLATE_LANG="sr"
HOST_WHATSAPP="382600000000"

# Upstash Redis — rate limits for /api/inquiry (REST URL + token from the console)
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXxx"
